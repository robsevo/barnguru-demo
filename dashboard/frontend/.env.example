# Copy to .env.local and edit. Nothing here is a real credential.
#
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real values.

# Sign-in accounts, as a JSON array. Login asks for all three fields.
# The demo account is intentionally trivial — change it before deploying.
AUTH_USERS=[{"username":"demo","password":"demo","secret_word":"demo"}]

# Signs the session cookie. Generate your own:
#   openssl rand -base64 32
AUTH_SESSION_SECRET=

# Where the FastAPI backend listens. Every /api/* call is proxied here by
# app/api/[...backend]/route.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
