
# Environment files. A real one leaked into an early copy of this build — it
# carried a signing secret, live credentials and a Vercel OIDC token — so the
# rule is broad and the template is the single exception.
.env
.env.*
!.env.example

# Compiled PyO3 extension. Build it with:
#   uv run maturin develop --manifest-path engine/Cargo.toml --release
# It is NOT committed: the Rust toolchain bakes absolute build paths into the
# binary (the copy removed here carried 126 references to a developer's home
# directory), and a 9 MB artifact has no business in source control.
*.so
*.pyd
target/

# Generated demo dataset — reproduce with: uv run python scripts/make_demo_data.py
/data/

# Python bytecode. Not just clutter: .pyc files embed the absolute path of the
# source they were compiled from, so committing them leaks the build machine's
# directory layout. Six of them were staged before this rule existed.
__pycache__/
*.py[cod]
